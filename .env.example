# ========================================================
# J.A.R.V.I.S. Environment Variables Template
# Copy this file to .env and configure your optional API keys
# ========================================================

# Weather API (Optional - J.A.R.V.I.S. automatically uses free Open-Meteo if no key is provided!)
TOMORROW_API_KEY=your_tomorrow_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Picovoice Porcupine Access Key (Optional - J.A.R.V.I.S. uses offline OpenWakeWord ONNX by default)
PORCUPINE_ACCESS_KEY=your_porcupine_access_key_here

# Spotify Developer API (Required for Spotify skill)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Default Location for Weather & Telemetry
DEFAULT_CITY=Vadodara
